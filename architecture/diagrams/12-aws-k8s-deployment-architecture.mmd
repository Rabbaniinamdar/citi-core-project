    classDef dr fill:#f3f4f6,stroke:#9ca3af,stroke-dasharray: 5 5;
    classDef cicd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px;
    classDef planned fill:#f3f4f6,stroke:#9ca3af,stroke-dasharray: 5 5;

    class AWS_REGION_PRIMARY,EDGE_AWS,EKS_CLUSTER,DATA_SERVICES,NETWORKING aws;
    class ROUTE53,CLOUDFRONT,ALB,EDGE_AWS edge;
    class EKS_CLUSTER,SYSTEM_NS,INGRESS_NS,CITICORE_NS,DATA_NS,OBS_NS,SEC_NS eks;
    class GW_DEP,GW_SVC,AUTH_DEP,USER_DEP,ACC_DEP,TXN_DEP,NOTIF_DEP,LEDGER_DEP,EUREKA_DEP,CONFIG_DEP,GATEWAY_DEP,CORE_DEP,PLATFORM_DEP ns;
    class MYSQL_PRIMARY,MYSQL_REPLICA,REDIS_CLUSTER,MSK_KAFKA,S3_KYC,S3_BACKUP,SECRETS_MGR,DATA_SERVICES data;
    class VPC,PUBLIC_SUBNETS,PRIVATE_SUBNETS,DATA_SUBNETS,NAT_GW,TGW,VPCE,NETWORKING net;
    class AWS_REGION_DR,DR_EKS,DR_MYSQL,DR_MSK,DR_S3 dr;
    class CI_CD,BUILD,CONTAINER,REGISTRY,DEPLOY_STAGING,TEST_STAGING,APPROVE,DEPLOY_PROD,VERIFY cicd;
    class LEDGER_DEP planned;