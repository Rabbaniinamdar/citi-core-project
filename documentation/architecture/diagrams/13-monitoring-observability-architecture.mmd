    class INSTRUMENTATION,METRICS_INSTR,TRACING_INSTR,LOGGING_INSTR,JVM_METRICS,HTTP_METRICS,DB_METRICS,CACHE_METRICS,KAFKA_METRICS,BUSINESS_METRICS,TRACE_CONTEXT,SPAN_CREATION,CONTEXT_PROPAGATION,SAMPLING,JSON_FORMAT,MDC_FILTER,PII_MASKING,CORRELATION instr;
    class COLLECTION,PROMETHEUS,LOKI,TEMPO,OTLP collection;
    class STORAGE,TSDB,LOKI_STORE,TEMPO_STORE storage;
    class VISUALIZATION,GRAFANA,ALERTING viz;
    class DASHBOARDS,SYS_OVERVIEW,SVC_DEEP_DIVE,BUSINESS_KPI,SAGA_MONITOR,KAFKA_MONITOR,DB_MONITOR dashboards;
    class ALERT_RULES,ALERT_DOWN,ALERT_ERROR_RATE,ALERT_LATENCY,ALERT_KAFKA_LAG,ALERT_OUTBOX_LAG,ALERT_REPLICA_LAG,ALERT_DISK,ALERT_CERT,ALERT_BIZ alerting;
    class ALERT_DOWN,ALERT_ERROR_RATE,ALERT_LATENCY,ALERT_KAFKA_LAG,ALERT_OUTBOX_LAG,ALERT_REPLICA_LAG,ALERT_DISK,ALERT_CERT,ALERT_BIZ alerts;
    class NOTIFICATION_CHANNELS,SLACK,PAGERDUTY,EMAIL,WEBHOOK notify;
