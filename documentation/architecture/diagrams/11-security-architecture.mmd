    class AUTHENTICATION,AUTH_SVC,JWT_ACCESS,JWT_REFRESH,BCRYPT,MFA,LOCKOUT,RATE_AUTH,PWD_RESET,PWD_POLICY auth;
    class AUTHORIZATION,RBAC,ABAC,PRE_AUTH,OWNERSHIP,SERVICE_ROLE,KYC_GATE authz;
    class SERVICE_SECURITY,JWT_PROPAGATION,FEIGN_INTERCEPTOR,INDEPENDENT_VALIDATION,MTLS svc;
    class DATA_PROTECTION,TLS_TRANSIT,ENCRYPTION_AT_REST,PII_MASKING,SECRETS,KEY_MGMT data;
    class APPLICATION_SECURITY,INPUT_VALIDATION,OUTPUT_ENCODING,SQL_INJECTION,ERROR_HANDLING,AUDIT_LOGGING app;
    class CONTAINER_SECURITY,NON_ROOT,READ_ONLY_FS,CAP_DROP,IMAGE_SCAN,BASE_IMAGES container;
    class INFRASTRUCTURE_SECURITY,NETWORK_POLICIES,SECRETS_K8S,RBAC_K8S,AUDIT_K8S infra;
    class MONITORING_SECURITY,SIEM,ANOMALY,VULN_SCAN,PEN_TEST,INCIDENT_RESPONSE monitor;
